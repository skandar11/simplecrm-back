{
  "name": "xillion-backend",
  "version": "0.0.1",
  "repository": "https://github.com/Neca-development/xillion-backend.git",
  "author": "danya♥ <danilaskablov@gmail.com>",
  "license": "MIT",
  "private": true,
  "scripts": {
    "prebuild": "rimraf dist",
    "build": "nest build",
    "start": "node ./dist/src/main.js",
    "start:dev": "cross-env NODE_ENV=development nodemon",
    "start:prod": "npx cross-env NODE_ENV=production node ./dist/main.js",
    "migration:create": "yarn mikro-orm migration:create",
    "migration:up": "yarn mikro-orm migration:up",
    "migration:down": "yarn mikro-orm migration:down"
  },
  "dependencies": {
    "@mikro-orm/core": "^5.2.2",
    "@mikro-orm/migrations": "^5.2.2",
    "@mikro-orm/nestjs": "^5.0.2",
    "@mikro-orm/postgresql": "^5.2.2",
    "@nestjs/common": "^8.4.6",
    "@nestjs/config": "^2.1.0",
    "@nestjs/core": "^8.4.6",
    "@nestjs/jwt": "^8.0.1",
    "@nestjs/passport": "^9.0.0",
    "@nestjs/platform-express": "^8.4.6",
    "@nestjs/swagger": "^5.2.1",
    "@unistory/nestjs-common": "^1.0.4",
    "@unistory/route-decorators": "^1.0.2",
    "app-root-path": "^3.0.0",
    "bcrypt": "^5.0.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.13.2",
    "dotenv": "^16.0.1",
    "passport-jwt": "^4.0.0",
    "pg": "^8.7.3",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.5.5",
    "swagger-ui-express": "^4.4.0",
    "uuid": "^8.3.2"
  },
  "devDependencies": {
    "@mikro-orm/cli": "^5.2.2",
    "@nestjs/cli": "^8.2.8",
    "@types/bcrypt": "^5.0.0",
    "@types/express": "^4.17.13",
    "@types/node": "^17.0.38",
    "@types/uuid": "^8.3.4",
    "cross-env": "^7.0.3",
    "nodemon": "^2.0.16",
    "ts-node": "^10.8.0",
    "tsconfig-paths": "^4.0.0",
    "typescript": "^4.7.2"
  },
  "mikro-orm": {
    "useTsNode": true,
    "configPaths": [
      "./src/infra/mikro-orm.config.ts",
      "./dist/infra/mikro-orm.config.js"
    ]
  }
}
